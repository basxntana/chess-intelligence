# Copy to infrastructure/.env (git-ignored) and fill in. Never commit the real file.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
PUBLIC_APP_URL=https://chess.example.com        # where users open the frontend (CORS origin)
PUBLIC_API_URL=https://api.chess.example.com    # where browsers reach the backend
ANALYSIS_WORKERS=2                              # engine processes; ~1 CPU core each
MAX_QUEUED_JOBS=20
ANTHROPIC_API_KEY=                              # optional; empty = rule-based explanations only
LOG_LEVEL=INFO
